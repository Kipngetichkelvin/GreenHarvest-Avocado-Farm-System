# =========================================================
# GreenHarvest Avocado Farm System :: environment sample
# Copy this file to ".env" and adjust the values as needed.
#   copy .env.example .env        (Windows cmd)
#   cp .env.example .env          (bash)
# =========================================================

# --- HTTP -----------------------------------------------------------------
# Port the Express server listens on when started with `npm start`.
PORT=5000

# "development" | "production" | "test"
# When set to "test" the HTTP request logger (morgan) is silenced.
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Absolute or relative path to the SQLite database file.
# Defaults to <project>/database/greenharvest.db when omitted.
DB_PATH=database/greenharvest.db

# --- Authentication -------------------------------------------------------
# IMPORTANT: replace this with a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-secret-string
# Token lifetime accepted by jsonwebtoken (e.g. 30m, 12h, 7d).
JWT_EXPIRES_IN=7d

# --- Smoke test (optional) ------------------------------------------------
# Port used by scripts/smoke-test.js. 0 = pick a free ephemeral port.
SMOKE_PORT=0
